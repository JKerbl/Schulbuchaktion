<nav class="nav-bar-outer">
    <div class="burger-menu" onclick="toggleMenu()">
        <img style="height: 3em" src="{{ asset('images/hamburger.png') }}" alt="iconMenu">
    </div>
    <div class="nav-bar-inside">
        <div class="nav-bar-company-name-and-icon">
            <div class="logo-nav-bar">
                <img class="logo" src="/images/library_logo.png" alt="logo">
            </div>
            <a href="{{ path('landing_page') }}">
                <div class="company-name">Schulbuchaktion</div>
            </a>
        </div>
        <div class="nav-bar-elements">
            <div id="home" class="nav-bar-item">
                <a href="{{ path('landing_page') }}?" class="{% if app.request.get('_route') == 'landing_page' %}active{% endif %}">
                    <button class="navbar-button">Home</button>
                </a>
            </div>
            {% if app.user %}
                <div class="nav-bar-item">
                    <a href="{{ path('app_book_index') }}?{% if currentYear is defined %}year={{ currentYear }}{% endif %}{% if subjectFilter is defined %}&subject={{ subjectFilter }}{% endif %}{% if gradeFilter is defined %}&grade={{ gradeFilter }}{% endif %}{% if search is defined %}&search={{ search }}{% endif %}" class="{% if app.request.get('_route') == 'app_book_index' %}active{% endif %}">
                        <button class="navbar-button">Buch</button>
                    </a>
                </div>
                {% if 'ROLE_ADMIN' in app.user.roles or 'ROLE_FV' in app.user.roles %}
                    <div class="nav-bar-item">
                        <a href="{{ path('order.index') }}?{% if currentYear is defined %}year={{ currentYear }}{% endif %}{% if subjectFilter is defined %}&subject={{ subjectFilter }}{% endif %}{% if gradeFilter is defined %}&grade={{ gradeFilter }}{% endif %}{% if departmentFilter is defined %}&department={{ departmentFilter }}{% endif %}{% if search is defined %}&search={{ search }}{% endif %}" class="{% if app.request.get('_route') == 'order.index' %}active{% endif %}">
                            <button class="navbar-button">Bestellung</button>
                        </a>
                    </div>
                {% endif %}
                {% if 'ROLE_ADMIN' in app.user.roles %}
                    <div class="nav-bar-item">
                        <a href="{{ path('app_import') }}" class="{% if app.request.get('_route') == 'app_import' %}active{% endif %}">
                            <button class="navbar-button">Import</button>
                        </a>
                    </div>
                    <div class="nav-bar-item">
                        <a href="{{ path('app_increment') }}" onclick="return confirmIncrement()" class="{% if app.request.get('_route') == 'app_increment' %}active{% endif %}">
                            <button class="navbar-button">Neues Jahr</button>
                        </a>
                    </div>
                {% endif %}
                {% if 'ROLE_ADMIN' in app.user.roles or 'ROLE_AV' in app.user.roles or 'ROLE_FV' in app.user.roles %}
                    <div class="nav-bar-item">
                        <a href="{{ path('app_school_class_index') }}?{% if currentYear is defined %}year={{ currentYear }}{% endif %}{% if departmentFilter is defined %}&department={{ departmentFilter }}{% endif %}" class="{% if app.request.get('_route') == 'app_school_class_index' %}active{% endif %}">
                            <button class="navbar-button">Klasse</button>
                        </a>
                    </div>
                    <div class="nav-bar-item">
                        <a href="{{ path('app_department_index') }}?{% if currentYear is defined %}year={{ currentYear }}{% endif %}" class="{% if app.request.get('_route') == 'app_department_index' %}active{% endif %}">
                            <button class="navbar-button">Abteilung</button>
                        </a>
                    </div>
                {% endif %}
                {% if 'ROLE_ADMIN' in app.user.roles %}
                    <div class="nav-bar-item">
                        <a href="{{ path('app_subject_index') }}" class="{% if app.request.get('_route') == 'app_subject_index' %}active{% endif %}">
                            <button class="navbar-button">Schulfach</button>
                        </a>
                    </div>
                    <div class="nav-bar-item">
                        <a href="{{ path('user.index') }}" class="{% if app.request.get('_route') == 'user.index' %}active{% endif %}">
                            <button class="navbar-button">Benutzer</button>
                        </a>
                    </div>
                    <div class="nav-bar-item">
                        <a href="{{ path('app_parameter_index') }}" class="{% if app.request.get('_route') == 'app_parameter_index' %}active{% endif %}">
                            <button class="navbar-button">Parameter</button>
                        </a>
                    </div>
                {% endif %}
            {% endif %}
            <div class="nav-bar-item">
                <a href="{{ path('app_team') }}" class="{% if app.request.get('_route') == 'app_team' %}active{% endif %}">
                    <button class="navbar-button">Team</button>
                </a>
            </div>
            {% if app.user %}
                <div class="nav-bar-item">
                    <a href="{{ path('app_change_password') }}" class="{% if app.request.get('_route') == 'app_change_password' %}active{% endif %}">
                        <button class="navbar-button">Passwort ändern</button>
                    </a>
                </div>
                <div class="nav-bar-item" id="login-btn">
                    <a href="{{ path('app_logout') }}">
                        <button>Logout</button>
                    </a>
                </div>
            {% else %}
                <div class="nav-bar-item" id="login-btn">
                    <a href="{{ path('app_login') }}">
                        <button>Login</button>
                    </a>
                </div>
                <div class="nav-bar-item" id="register-btn">
                    <a href="{{ path('registration') }}">
                        <button>Registrieren</button>
                    </a>
                </div>
            {% endif %}
        </div>
    </div>
</nav>

{% for message in app.flashes('error') %}
    <div class="error-message">{{ message }}</div>
{% endfor %}

<script>
    function confirmIncrement() {
        return confirm('Klassen und Abteilungen für das neue Jahr erstellen?\nACHTUNG: Nur wenn die Bücher für das neue Jahr bereits importiert sind, werden auch die Bestellungen übernommen!');
    }
</script>