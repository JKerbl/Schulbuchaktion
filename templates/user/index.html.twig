{% extends 'base.html.twig' %}

{% block title %}{{ parent() }} Userübersicht{% endblock %}
{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('style/toggle.css') }}" type="text/css"/>
{% endblock %}

{% block body %}
    <div class="flex justify-between items-center my-8">
        <h1 class="text-4xl text-center w-full">Benutzerübersicht</h1>
        <label class="switch mr-8 flex items-center">
            <span class="ml-2"></span>
            <input id="toggleRegistration" type="checkbox" class="ml-2" {% if allowRegistrations == 1 %}checked{% endif %}>
            <span class="slider round"></span>
        </label>
    </div>

    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3 mx-8">
        {% for user in users %}
            <div class="bg-white rounded-lg shadow-md p-4">
                <p class="text-xl font-semibold mb-2">{{ user.username }}</p>
                <form action="{{ path('user.change_role', {'id': user.id}) }}" method="post" class="flex items-center">
                    <select name="role" class="mr-2 px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                        <option value="ROLE_USER" {% if 'ROLE_USER' in user.roles %}selected{% endif %}>User</option>
                        <option value="ROLE_AV" {% if 'ROLE_AV' in user.roles %}selected{% endif %}>AV</option>
                        <option value="ROLE_FV" {% if 'ROLE_FV' in user.roles %}selected{% endif %}>FV</option>
                        <option value="ROLE_ADMIN" {% if 'ROLE_ADMIN' in user.roles %}selected{% endif %}>Admin</option>
                    </select>
                    <button type="submit" class="bg-blue-500 text-white px-4 py-2 rounded-md hover:bg-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-opacity-50">
                        Speichern
                    </button>
                    {% if thisUser.username != user.username %}
                        <a href="{{ path('app_reset_password', {'id': user.id }) }}" onclick="return confirmResetPassword('{{ user.username }}')" class="bg-green-500 text-white px-4 py-2 rounded-md hover:bg-red-600 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-opacity-50 ml-auto">
                            PW zurücksetzen
                        </a>
                    {% endif %}
                    <a href="{{ path('user.delete', {'id': user.id }) }}" onclick="return confirmDelete('{{ user.username }}')" class="bg-red-500 text-white px-4 py-2 rounded-md hover:bg-red-600 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-opacity-50 ml-auto">
                        Löschen
                    </a>
                </form>
            </div>
        {% endfor %}
    </div>

    <script>
        function confirmDelete(username) {
            return confirm('Sind Sie sicher, dass Sie den Benutzer ' + username + ' und alle seine Zuteilungen löschen möchten?');
        }

        function confirmResetPassword(username) {
            return confirm('Sind Sie sicher, dass Sie das Passwort von ' + username + ' zurücksetzen möchten?');
        }

        $(document).ready(function (){

            $('#toggleRegistration').change(function () {
                $.ajax({
                    url: '{{ path('toggle_registration') }}',
                    type: 'POST',
                    success: function (data) {
                        console.log(data);
                    },
                    error: function (error) {
                        console.log(error);
                    }
                });
            });

        })
    </script>
{% endblock %}
