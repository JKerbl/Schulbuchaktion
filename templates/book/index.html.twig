{% extends 'base.html.twig' %}

{% block title %}{{ parent() }} Buchübersicht{% endblock %}
{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('style/stylingBestellungen.css') }}" type="text/css"/>
{% endblock %}

{% block body %}
    <div class="container mx-auto p-4">

        <div class="book-filters flex flex-wrap justify-between items-center">
    <div class="flex items-center">
        <form id="bookFilterForm" method="get" action="{{ path('app_book_index') }}" class="flex justify-between items-center">
            <div class="flex items-center mr-5" >
                <label id="label-year-filter" for="yearFilter" class="book-filter-label">Jahr:  </label>
                <select id="yearFilter" name="year" class="book-filter">
                    {% for year in allYears %}
                        {% if year == currentYear %}
                            <option value="{{ year }}" selected>{{ year }}</option>
                        {% else %}
                            <option value="{{ year }}">{{ year }}</option>
                        {% endif %}
                    {% endfor %}
                </select>
            </div>
            <div class="flex items-center mr-5">
                <label id="label-subject-filter" for="subjectFilter" class="book-filter-label">Gegenstand:  </label>
                <select id="subjectFilter" name="subject" class="book-filter">
                    {% if subjectFilter == 0 %}
                        <option value="0" selected>Alle</option>
                    {% else %}
                        <option value="0">Alle</option>
                    {% endif %}
                    {% for subject in subjects %}
                        {% if subject.id == subjectFilter %}
                            <option value="{{ subject.id }}" selected>{{ subject.fullname }}</option>
                        {% else %}
                            <option value="{{ subject.id }}">{{ subject.fullname }}</option>
                        {% endif %}
                    {% endfor %}
                </select>
            </div>
            <div class="flex items-center mr-5">
                <label id="label-grade-filter" for="gradeFilter" class="book-filter-label">Jahrgang:  </label>
                <select id="gradeFilter" name="grade" class="book-filter">
                    {% if gradeFilter == 0 %}
                        <option value="0" selected>Alle</option>
                    {% else %}
                        <option value="0">Alle</option>
                    {% endif %}
                    {% for i in 1..5 %}
                        {% if i == gradeFilter %}
                            <option value="{{ i }}" selected>{{ i }}</option>
                        {% else %}
                            <option value="{{ i }}">{{ i }}</option>
                        {% endif %}
                    {% endfor %}
                </select>
            </div>
            <div class="flex items-center">
                <input type="text" name="search" value="{{ search }}" placeholder="Suche nach einem Buch..."
                       class="border px-4 py-2 w-full rounded-md"/>
                <button type="submit" class="bg-blue-500 text-white rounded-md px-4 py-2 ml-2 hover:bg-blue-800 ease-in-out duration-300">Suchen</button>
            </div>
        </form>
    </div>
</div>

        <div class="overflow-x-auto">
            <table class="min-w-full bg-white shadow-md rounded-lg overflow-hidden">
                <thead>
                <tr>
                    <th class="px-2 py-2 bg-gray-100">B.Nr.</th>
                    <th class="px-2 py-2 bg-gray-100">Kurztitel</th>
                    <th class="px-2 py-2 bg-gray-100">Titel</th>
                    <th class="px-2 py-2 bg-gray-100">Schulform</th>
                    <th class="px-2 py-2 bg-gray-100">Info</th>
                    <th class="px-2 py-2 bg-gray-100">E-Book</th>
                   <!-- <th class="px-2 py-2 bg-gray-100">E-Book+</th> -->
                    <th class="px-2 py-2 bg-gray-100">Schulst.</th>
                    <th class="px-2 py-2 bg-gray-100">Preis</th>
                    <th class="px-2 py-2 bg-gray-100">Jahr</th>
                    {% if 'ROLE_ADMIN' in user.roles or 'ROLE_FV' in user.roles %}
                        <th class="px-2 py-2 bg-gray-100">Bestellen</th>
                    {% endif %}
                </tr>
                </thead>
                <tbody>
                {% for book in books %}
                    <tr class="border-b">
                        <td class="px-4 py-2">{{ book.bnr }}</td>
                        <td class="px-4 py-2">{{ book.shortTitle }}</td>
                        <td class="px-4 py-2">{{ book.title }}</td>
                        <td class="px-4 py-2">{{ book.schoolForm }}</td>
                        <td class="px-4 py-2">{{ book.info }}</td>
                        <td class="px-4 py-2">{{ book.eBook ? 'Ja' : 'Nein' }}</td>
                        <td class="px-4 py-2">{{ book.schoolGrades }}</td>
                        <td class="px-4 py-2">{{ book.price | number_format(2, ',','.')}}</td>
                        <td class="px-4 py-2">{{ book.year }}</td>
                        {% if 'ROLE_ADMIN' in user.roles or 'ROLE_FV' in user.roles %}
                            <td class="px-4 py-2">
                                <a href="{{ path('orderBook', {id: book.id, subject: subjectFilter, grade: gradeFilter, search: search}) }}"
                                   class=""><img class="order-img-size" src="{{ asset('images/order.png') }}" alt="Bestellen"></a>
                            </td>
                        {% endif %}
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="10" class="px-4 py-2 text-center">Keine Einträge gefunden</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>

        <nav aria-label="Page navigation" class="my-12 flex justify-center">
            <ul class="inline-flex -space-x-px">
                <li>
                    <a href="{{ path('app_book_index', {page: currentPage-1, search: search, year: currentYear, subject: subjectFilter, grade: gradeFilter}) }}"
                       class="px-3 py-2 ml-0 leading-tight text-gray-500 bg-white border border-gray-300 rounded-l-lg
                       hover:bg-gray-100 hover:text-gray-700 {% if currentPage == 0 %}cursor-not-allowed{% endif %}">
                        &laquo; Previous
                    </a>
                </li>
                {% if currentPage > 3 %}
                    <li>
                        <a href="{{ path('app_book_index', {page: 0, search: search, year: currentYear, subject: subjectFilter, grade: gradeFilter}) }}"
                           class="px-3 py-2 leading-tight text-gray-500 bg-white border border-gray-300
                           hover:bg-gray-100 hover:text-gray-700">
                            1
                        </a>
                    </li>
                    <li>
                        <span class="px-3 py-2 leading-tight text-gray-500 bg-white border border-gray-300">
                            ...
                        </span>
                    </li>
                {% endif %}
                {% for page in (currentPage > 2 ? currentPage - 2 : 1) .. (currentPage < maxPages - 1 ? currentPage + 2 : maxPages) %}
                    <li>
                        <a href="{{ path('app_book_index', {page: page, search: search, year: currentYear, subject: subjectFilter, grade: gradeFilter}) }}"
                           class="px-3 py-2 leading-tight text-gray-500 bg-white border border-gray-300
                           hover:bg-gray-100 hover:text-gray-700 {% if page == currentPage %}bg-blue-500 text-gray-900{% endif %}">
                            {{ page }}
                        </a>
                    </li>
                {% endfor %}
                {% if currentPage < maxPages - 2 %}
                    <li>
                        <span class="px-3 py-2 leading-tight text-gray-500 bg-white border border-gray-300">
                            ...
                        </span>
                    </li>
                    <li>
                        <a href="{{ path('app_book_index', {page: maxPages, search: search, year: currentYear, subject: subjectFilter, grade: gradeFilter}) }}"
                           class="px-3 py-2 leading-tight text-gray-500 bg-white border border-gray-300
                           hover:bg-gray-100 hover:text-gray-700">
                            {{ maxPages }}
                        </a>
                    </li>
                {% endif %}
                <li>
                    <a href="{{ path('app_book_index', {page: currentPage + 1, search: search, year: currentYear, subject: subjectFilter, grade: gradeFilter}) }}"
                       class="px-3 py-2 leading-tight text-gray-500 bg-white border border-gray-300 rounded-r-lg
                       hover:bg-gray-100 hover:text-gray-700 {% if currentPage == maxPages %}cursor-not-allowed{% endif %}">
                        Next &raquo;
                    </a>
                </li>
            </ul>
        </nav>
    </div>

    <script>
        document.getElementById('yearFilter').addEventListener('change', function() {
            document.getElementById('bookFilterForm').submit();
        });
        document.getElementById('subjectFilter').addEventListener('change', function() {
            document.getElementById('bookFilterForm').submit();
        });
        document.getElementById('gradeFilter').addEventListener('change', function() {
            document.getElementById('bookFilterForm').submit();
        });
    </script>


{% endblock %}
