{% extends 'base.html.twig' %}

{% block title %}{{ parent() }} Parameterübersicht{% endblock %}

{% block stylesheets %}
    <link href="{{ asset('style/stylingLandingPageAndNavbar.css') }}" type="text/css" rel="stylesheet"/>
    <link href="{{ asset('/style/stylingSchoolClassAndDepartmentAndOrder.css') }}" type="text/css" rel="stylesheet"/>
    <link rel="stylesheet" href="{{ asset('style/stylingBestellungen.css') }}" type="text/css"/>
{% endblock %}

{% block body %}
    <div class="text-4xl">
        <h1>Parameter</h1>
    </div>

    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Wert</th>
                <th>
                    <form id="yearForm" method="get" action="{{ path('app_parameter_index') }}">
                        <select id="yearFilter" name="year" class="year-filter">
                            {% for year in allYears %}
                                {% if year == currentYear %}
                                    <option value="{{ year }}" selected>{{ year }}</option>
                                {% else %}
                                    <option value="{{ year }}">{{ year }}</option>
                                {% endif %}
                            {% endfor %}
                        </select>
                    </form>
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        {% for parameter in parameters %}
            <tr>
                <td>{{ parameter.name }}</td>
                <td>{{ parameter.value }}</td>
                <td>{{ parameter.year }}</td>
                <td style="width: 8%">
                    <a style="display: inline-block" href="{{ path('app_parameter_edit', {'id': parameter.id}) }}"><img class="img-size" src="{{ asset('images/edit.png') }}" alt="Bearbeiten"></a>
                    <a style="display: inline-block" href="{{ path('app_parameter_delete', {'id': parameter.id}) }}"><img class="img-size" src="{{ asset('images/delete.png') }}" alt="delete"></a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">Keine Parameter gefunden</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <script>
        document.getElementById('yearFilter').addEventListener('change', function () {
            document.getElementById('yearForm').submit();
        });
    </script>
{% endblock %}
