{% extends 'base.html.twig' %}

{% block title %}{{ parent() }} Bestellen{% endblock %}

    {% block stylesheets %}
        <link rel="stylesheet" href="{{ asset('style/stylingBestellungen.css') }}" type="text/css"/>
    {% endblock %}

{% block body %}

    <div>
        <div class="order-filters">
            <form id="bookFilterForm" method="get" action="{{ path('order.index') }}" class="flex items-center">
                <label id="label-year-filter" for="yearFilter" class="order-filter-label">Jahr:</label>
                <select id="yearFilter" name="year" class="order-filter">
                    {% for year in allYears %}
                        {% if year == currentYear %}
                            <option value="{{ year }}" selected>{{ year }}</option>
                        {% else %}
                            <option value="{{ year }}">{{ year }}</option>
                        {% endif %}
                    {% endfor %}
                </select>

                <label id="label-department-filter" for="departmentFilter" class="order-filter-label">Abteilung:</label>
                <select id="departmentFilter" name="department" class="order-filter">
                    {% if departmentFilter == 0 %}
                        <option value="0" selected>Alle</option>
                    {% else %}
                        <option value="0">Alle</option>
                    {% endif %}
                    {% for department in departments %}
                        {% if department.id == departmentFilter %}
                            <option value="{{ department.id }}" selected>{{ department.name }}</option>
                        {% else %}
                            <option value="{{ department.id }}">{{ department.name }}</option>
                        {% endif %}
                    {% endfor %}
                </select>

                <label id="label-grade-filter" for="gradeFilter" class="order-filter-label">Jahrgang:</label>
                <select id="gradeFilter" name="grade" class="order-filter">
                    {% if gradeFilter == 0 %}
                        <option value="0" selected>Alle</option>
                    {% else %}
                        <option value="0">Alle</option>
                    {% endif %}
                    {% for i in 1..5 %}
                        {% if i == gradeFilter %}
                            <option value="{{ i }}" selected>{{ i }}</option>
                        {% else %}
                            <option value="{{ i }}">{{ i }}</option>
                        {% endif %}
                    {% endfor %}
                </select>

                <label id="label-subject-filter" for="subjectFilter" class="order-filter-label">Gegenstand:</label>
                <select id="subjectFilter" name="subject" class="order-filter mr-5">
                    {% if subjectFilter == 0 %}
                        <option value="0" selected>Alle</option>
                    {% else %}
                        <option value="0">Alle</option>
                    {% endif %}
                    {% for subject in subjects %}
                        {% if subject.id == subjectFilter %}
                            <option value="{{ subject.id }}" selected>{{ subject.fullname }}</option>
                        {% else %}
                            <option value="{{ subject.id }}">{{ subject.fullname }}</option>
                        {% endif %}
                    {% endfor %}
                </select>

                <!-- Three filters that are not displayed to include them in the URL when submitting the form -->
                <select id="sortByFilter" name="sortBy" class="order-filter mr-5" style="display: none">
                    <option value="{{ sortBy }}" selected id="sortByValue"></option>
                </select>

                <select id="sortDirectionFilter" name="sortDirection" class="order-filter mr-5" style="display: none">
                    <option value="{{ sortDirection }}" selected id="sortDirectionValue"></option>
                </select>
                <select id="sortDirectionFilter" name="page" class="order-filter mr-5" style="display: none">
                    <option value="{{ currentPage }}" selected id="pageValue"></option>
                </select>

                <div class="flex items-center">
                    <input type="text" name="search" value="{{ search }}" placeholder="Suche..."
                           class="border px-4 py-2 w-full rounded-md"/>
                    <a href="#" onclick="changePage({{ currentPage }})" class="bg-blue-500 text-white rounded-md px-4 py-2 ml-2 hover:bg-blue-800 ease-in-out duration-300">Suchen</a>
                </div>
            </form>
        </div>
        <table class="table">
            <thead>
            <tr>
                <th style="width: 15%" id="bnrHeader">
                    Buchnummer
                    <!-- Builds the image-tag -->
                    <img style="display: inline-block; height: 20px; transform:
                    {% if sortBy == 'class' %}
                            rotate(90deg);
                    {% else %}
                        {% if sortDirection == 'ASC' %}
                                rotate(180deg);
                        {% else %}
                                rotate(0deg);
                        {% endif %}
                    {% endif %}"
                            {% if sortBy == 'bnr' %}
                                src="{{ asset('images/sortingArrowBlue.png') }}"
                            {% else %}
                                src="{{ asset('images/sortingArrowGrey.png') }}"
                            {% endif %}
                         alt="sortingArrow">
                </th>
                <th>Buch</th>
                <th>mit Rep.</th>
                <th>Anzahl nicht Repetenten</th>
                <th>Anzahl Repetenten</th>
                <th hidden>Lehrerexemplar</th>
                <th>eBook</th>
                <!--<th>eBook Plus</th> -->
                <th style="width: 15%" id="classHeader">
                    Schulklasse
                    <img style="display: inline-block; height: 20px; transform:
                    {% if sortBy == 'bnr' %}
                            rotate(90deg);
                    {% else %}
                            {% if sortDirection == 'ASC' %}
                                rotate(180deg);
                            {% else %}
                                rotate(0deg);
                            {% endif %}
                    {% endif %}"
                            {% if sortBy == 'class' %}
                                src="{{ asset('images/sortingArrowBlue.png') }}"
                            {% else %}
                                src="{{ asset('images/sortingArrowGrey.png') }}"
                            {% endif %}
                         alt="sortingArrow">
                </th>
                {% if 'ROLE_ADMIN' in user.roles or ('ROLE_FV' in user.roles and currentYear is same as "now"|date('Y')) %}
                    <th style="width: 5%"></th>
                {% endif %}
            </tr>
            </thead>
            <tbody id="orderTable">
            {% for order in orders %}
                <tr>
                    <td>{{ order.book ? order.book.bnr : 'Nicht zugewiesen' }}</td>
                    <td>{{ order.book ? order.book.shortTitle : 'Nicht zugewiesen' }}</td>
                    <td>{{ order.orderFor == 'Mit Repetenten' ? 'Ja' : 'Nein' }}</td>
                    {% if order.orderFor == 'Mit Repetenten' %}
                        <td>{{ order.schoolclass.studentsAmount }}</td>
                        <td>{{ order.schoolclass.repAmount }}</td>
                    {% elseif order.orderFor == 'Ohne Repetenten' %}
                        <td>{{ order.schoolclass.studentsAmount }}</td>
                        <td>0</td>
                    {% elseif order.orderFor == 'Nur Repetenten' %}
                        <td>0</td>
                        <td>{{ order.schoolclass.repAmount }}</td>
                    {% endif %}
                    <td hidden>{{ order.teacherCopy ? 'Ja' : 'Nein' }}</td>
                    <td>{{ order.eBook ? 'Ja' : 'Nein' }}</td>
                    <td>{{ order.schoolclass ? order.schoolclass.name : 'Nicht zugewiesen' }}</td>
                    {% if 'ROLE_ADMIN' in user.roles or ('ROLE_FV' in user.roles and currentYear is same as "now"|date('Y')) %}
                        <td style="width: 8%">
                            <a style="display: inline-block" href="{{ path('app_book_order_edit', {'id': order.id}) }}"><img class="img-size" src="{{ asset('images/edit.png') }}" alt="Bearbeiten"></a>
                            <a style="display: inline-block" href="{{ path('order.delete', {'id': order.id}) }}"><img class="img-size" src="{{ asset('images/delete.png') }}" alt="delete"></a>
                        </td>
                    {% endif %}
                </tr>
            {% endfor %}
            </tbody>
        </table>

        <nav aria-label="Page navigation" class="my-12 flex justify-center">
            <ul class="inline-flex -space-x-px">
                <li>
                    <a href="#" onclick="changePage({{ currentPage - 1 }})"
                       class="px-3 py-2 ml-0 leading-tight text-gray-500 bg-white border border-gray-300 rounded-l-lg
                       hover:bg-gray-100 hover:text-gray-700 {% if currentPage == 0 %}cursor-not-allowed{% endif %}">
                        &laquo; Previous
                    </a>
                </li>
                {% if currentPage > 3 %}
                    <li>
                        <a href="#" onclick="changePage(1)"
                           class="px-3 py-2 leading-tight text-gray-500 bg-white border border-gray-300
                           hover:bg-gray-100 hover:text-gray-700">
                            1
                        </a>
                    </li>
                    <li>
                        <span class="px-3 py-2 leading-tight text-gray-500 bg-white border border-gray-300">
                            ...
                        </span>
                    </li>
                {% endif %}
                {% for page in (currentPage > 2 ? currentPage - 2 : 1) .. (currentPage < maxPages - 1 ? currentPage + 2 : maxPages) %}
                    <li>
                        <a href="#" onclick="changePage({{ page }})"
                           class="px-3 py-2 leading-tight text-gray-500 bg-white border border-gray-300
                           hover:bg-gray-100 hover:text-gray-700 {% if page == currentPage %}bg-blue-500 text-gray-900{% endif %}">
                            {{ page }}
                        </a>
                    </li>
                {% endfor %}
                {% if currentPage < maxPages - 2 %}
                    <li>
                        <span class="px-3 py-2 leading-tight text-gray-500 bg-white border border-gray-300">
                            ...
                        </span>
                    </li>
                    <li>
                        <a href="#" onclick="changePage({{ maxPages }})"
                           class="px-3 py-2 leading-tight text-gray-500 bg-white border border-gray-300
                           hover:bg-gray-100 hover:text-gray-700">
                            {{ maxPages }}
                        </a>
                    </li>
                {% endif %}
                <li>
                    <a href="#" onclick="changePage({{ currentPage + 1 }})"
                       class="px-3 py-2 leading-tight text-gray-500 bg-white border border-gray-300 rounded-r-lg
                       hover:bg-gray-100 hover:text-gray-700 {% if currentPage == maxPages %}cursor-not-allowed{% endif %}">
                        Next &raquo;
                    </a>
                </li>
            </ul>
        </nav>


    </div>

    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
    <script>
        document.getElementById('yearFilter').addEventListener('change', function () {
            document.getElementById('bookFilterForm').submit();
        });
        document.getElementById('departmentFilter').addEventListener('change', function () {
            document.getElementById('bookFilterForm').submit();
        });
        document.getElementById('gradeFilter').addEventListener('change', function () {
            document.getElementById('bookFilterForm').submit();
        });
        document.getElementById('subjectFilter').addEventListener('change', function() {
            document.getElementById('bookFilterForm').submit();
        });

        // handling of sorting
        let $sortByFilter = document.getElementById('sortByFilter');
        let $sortDirectionFilter = document.getElementById('sortDirectionFilter');

        let $bnrHeader = document.getElementById('bnrHeader');
        let $classHeader = document.getElementById('classHeader');

        $bnrHeader.addEventListener('click', function () {
            if ($sortByFilter.value === 'class') {
                document.getElementById('sortByValue').value = 'bnr';
            }
            document.getElementById('sortDirectionValue').value = $sortDirectionFilter.value === 'ASC' ? 'DESC' : 'ASC';

            document.getElementById('bookFilterForm').submit();
        });

        $classHeader.addEventListener('click', function () {
            if ($sortByFilter.value === 'bnr') {
                document.getElementById('sortByValue').value = 'class';
            }
            document.getElementById('sortDirectionValue').value = $sortDirectionFilter.value === 'ASC' ? 'DESC' : 'ASC';

            document.getElementById('bookFilterForm').submit();
        });

        function changePage(page) {
            document.getElementById('pageValue').value = page;
            document.getElementById('bookFilterForm').submit();
        }
    </script>
{% endblock %}