{% extends 'base.html.twig' %}

{% block title %}{{ parent() }} Bestellen{% endblock %}

    {% block stylesheets %}
        <link rel="stylesheet" href="{{ asset('style/stylingBestellungen.css') }}" type="text/css"/>
    {% endblock %}

{% block body %}

    <div>
        <div class="order-filters">
            <label id="label-year-filter" for="yearFilter" class="order-filter-label">Jahr:</label>
            <select id="yearFilter" name="yearId" class="order-filter">
                <option value="{{ currentYear }}">{{ currentYear }}</option>
                <option value="2025">2025</option>
            </select>

            <label id="label-department-filter" for="departmentFilter" class="order-filter-label">Abteilung filtern:</label>
            <select id="departmentFilter" name="departmentId" class="order-filter">
                <option value="0">Alle Abteilungen</option>
                {% for department in departments %}
                    <option value="{{ department.id }}">{{ department.name }}</option>
                {% endfor %}
            </select>

            <label id="label-grade-filter" for="gradeFilter" class="order-filter-label">Jahrgänge filtern:</label>
            <select id="gradeFilter" name="gradeId" class="order-filter">
                <option value="0">Alle Jahrgänge</option>
                {% for i in 1..5 %}
                    <option value="{{ i }}">{{ i }}</option>
                {% endfor %}
            </select>

        </div>
        <table class="table">
            <thead>
            <tr>
                <th>Bestellnummer</th>
                <th>Anzahl</th>
                <th>Lehrerexemplar</th>
                <th>eBook</th>
                <th>eBook Plus</th>
                <th>Schulklasse</th>
                <th>Buch</th>
                <th>Optionen</th>
            </tr>
            </thead>
            <tbody id="orderTable">
            {% for order in orders %}
                <tr>
                    <td>{{ order.id }}</td>
                    <td>{{ order.count }}</td>
                    <td>{{ order.teacherCopy ? 'Ja' : 'Nein' }}</td>
                    <td>{{ order.eBook ? 'Ja' : 'Nein' }}</td>
                    <td>{{ order.eBookPlus ? 'Ja' : 'Nein' }}</td>
                    <td>{{ order.schoolclass ? order.schoolclass.name : 'Nicht zugewiesen' }}</td>
                    <td>{{ order.book ? order.book.title : 'Nicht zugewiesen' }}</td>
                    <td>
                        <a href="{{ path('order.delete', {'id': order.id}) }}"><img class="img-size" src="{{ asset('images/delete.png') }}" alt="delete"></a>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#yearFilter').change(function () {
                var year = $(this).val();
                var departmentId = $('#departmentFilter').val();
                var grade = $('#gradeFilter').val();
                $.ajax({
                    url: '/orderbooks/filter/' + year + "/" + departmentId + "/" + grade,
                    type: 'GET',
                    success: function (response) {
                        $('#departmentFilter').html('');
                        $.ajax({
                            url: '/orderbooks/getDepartments/' + year,
                            type: 'GET',
                            success: function (response) {
                                var departments = response.departments;
                                var departmentFilter = $('#departmentFilter');
                                departmentFilter.append('<option value="0">Alle Abteilungen</option>');
                                for (var i = 0; i < departments.length; i++) {
                                    departmentFilter.append('<option value="' + departments[i].id + '">' + departments[i].name + '</option>');
                                }
                            }
                        })

                        filterOrders(response);
                    }
                });
            });

            $('#departmentFilter').change(function () {
                var year = $('#yearFilter').val();
                var departmentId = $(this).val();
                var grade = $('#gradeFilter').val();
                $.ajax({
                    url: '/orderbooks/filter/' + year + "/" + departmentId + "/" + grade,
                    type: 'GET',
                    success: function (response) {
                        filterOrders(response);
                    }
                });
            });

            $('#gradeFilter').change(function () {
                var year = $('#yearFilter').val();
                var departmentId = $('#departmentFilter').val();
                var grade = $(this).val();
                $.ajax({
                    url: '/orderbooks/filter/' + year + "/" + departmentId + "/" + grade,
                    type: 'GET',
                    success: function (response) {
                        filterOrders(response);
                    }
                });
            });
        });

        function filterOrders(response){
            var orders = response.orders;
            console.log(response.year);

            var orderTable = $('#orderTable');

            orderTable.html('');

            for (var i = 0; i < orders.length; i++) {
                var row = $('<tr></tr>');
                console.log(orders[i].toString());
                row.append('<td>' + orders[i].id + '</td>');
                row.append('<td>' + orders[i].count + '</td>');
                row.append('<td>' + (orders[i].teacherCopy ? 'Ja' : 'Nein') + '</td>');
                row.append('<td>' + (orders[i].eBook ? 'Ja' : 'Nein') + '</td>');
                row.append('<td>' + (orders[i].eBookPlus ? 'Ja' : 'Nein') + '</td>');
                row.append('<td>' + (orders[i].schoolclass ? orders[i].schoolclass : 'Nicht zugewiesen') + '</td>');
                row.append('<td>' + (orders[i].book ? orders[i].book : 'Nicht zugewiesen') + '</td>');
                orderTable.append(row);
            }
        }
    </script>
{% endblock %}