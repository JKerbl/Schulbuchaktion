{% extends 'base.html.twig' %}

{% block title %}{{ parent() }} Bestellen{% endblock %}

    {% block stylesheets %}
        <link rel="stylesheet" href="{{ asset('style/stylingBestellungen.css') }}" type="text/css"/>
    {% endblock %}

{% block body %}

    <div>
        <div class="order-filters">
            <form id="bookFilterForm" method="get" action="{{ path('order.index') }}" class="flex items-center">
            <label id="label-year-filter" for="yearFilter" class="order-filter-label">Jahr:</label>
            <select id="yearFilter" name="year" class="order-filter">
                {% for year in allYears %}
                    {% if year == currentYear %}
                        <option value="{{ year }}" selected>{{ year }}</option>
                    {% else %}
                        <option value="{{ year }}">{{ year }}</option>
                    {% endif %}
                {% endfor %}
            </select>

            <label id="label-department-filter" for="departmentFilter" class="order-filter-label">Abteilung:</label>
            <select id="departmentFilter" name="department" class="order-filter">
                {% if departmentFilter == 0 %}
                    <option value="0" selected>Alle Abteilungen</option>
                {% else %}
                    <option value="0">Alle Abteilungen</option>
                {% endif %}
                {% for department in departments %}
                    {% if department.id == departmentFilter %}
                        <option value="{{ department.id }}" selected>{{ department.name }}</option>
                    {% else %}
                        <option value="{{ department.id }}">{{ department.name }}</option>
                    {% endif %}
                {% endfor %}
            </select>

            <label id="label-grade-filter" for="gradeFilter" class="order-filter-label">Jahrgang:</label>
            <select id="gradeFilter" name="grade" class="order-filter">
                {% if gradeFilter == 0 %}
                    <option value="0" selected>Alle Jahrgänge</option>
                {% else %}
                    <option value="0">Alle Jahrgänge</option>
                {% endif %}
                {% for i in 1..5 %}
                    {% if i == gradeFilter %}
                        <option value="{{ i }}" selected>{{ i }}</option>
                    {% else %}
                        <option value="{{ i }}">{{ i }}</option>
                    {% endif %}
                {% endfor %}
            </select>

                <div class="flex items-center">
                    <input type="text" name="search" value="{{ search }}" placeholder="Suche nach einem Buch..."
                           class="border px-4 py-2 w-full rounded-md"/>
                    <button type="submit" class="bg-blue-500 text-white rounded-md px-4 py-2 ml-2 hover:bg-blue-800 ease-in-out duration-300">Suchen</button>
                </div>
            </form>
        </div>
        <table class="table">
            <thead>
            <tr>
                <th>Buchnummer</th>
                <th>Buch</th>
                <th>Anzahl</th>
                <th>Lehrerexemplar</th>
                <th>eBook</th>
                <th>eBook Plus</th>
                <th>Schulklasse</th>
                <th>Optionen</th>
            </tr>
            </thead>
            <tbody id="orderTable">
            {% for order in orders %}
                <tr>
                    <td>{{ order.book ? order.book.title : 'Nicht zugewiesen' }}</td>
                    <td>{{ order.count }}</td>
                    <td>{{ order.teacherCopy ? 'Ja' : 'Nein' }}</td>
                    <td>{{ order.eBook ? 'Ja' : 'Nein' }}</td>
                    <td>{{ order.eBookPlus ? 'Ja' : 'Nein' }}</td>
                    <td>{{ order.schoolclass ? order.schoolclass.name : 'Nicht zugewiesen' }}</td>
                    <td>
                        <a href="{{ path('order.delete', {'id': order.id}) }}"><img class="img-size" src="{{ asset('images/delete.png') }}" alt="delete"></a>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
    <script>
        document.getElementById('yearFilter').addEventListener('change', function () {
            document.getElementById('bookFilterForm').submit();
        });
        document.getElementById('departmentFilter').addEventListener('change', function () {
            document.getElementById('bookFilterForm').submit();
        });
        document.getElementById('gradeFilter').addEventListener('change', function () {
            document.getElementById('bookFilterForm').submit();
        });
    </script>
{% endblock %}