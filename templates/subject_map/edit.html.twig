{% extends 'base.html.twig' %}

{% block title %}{{ parent() }} {{ subject_map.name }} Bearbeiten{% endblock %}

    {% block stylesheets %}
        <link href="{{ asset('style/stylingLandingPageAndNavbar.css') }}" type="text/css" rel="stylesheet"/>
        <link href="{{ asset('/style/stylingSchoolClassAndDepartmentAndOrder.css') }}" type="text/css" rel="stylesheet"/>
    {% endblock %}

{% block body %}


    <div class="text-4xl">
        <h1>Fachbereich ändern</h1>
    </div>

    <div class="content-form">
        <form method="post">
            {{ form_start(form) }}
            {{ form_widget(form) }}
            <div class="btn-links-under-form">
                <button class="save-update-btn-form" type="submit">{{ button_label|default('Speichern') }}</button>
                <div class="back-to-list-btn">
                    <a class="anchor-back-to-list" href="{{ path('app_subject_map_index') }}">Zurück zur Liste</a>
                </div>
            </div>
            {{ form_end(form) }}
        </form>
    </div>

{% endblock %}
