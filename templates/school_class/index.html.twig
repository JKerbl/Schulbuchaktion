{% extends 'base.html.twig' %}

{% block title %}{{ parent() }} Schulklasse Übersicht{% endblock %}

{% block stylesheets %}
    <link href="{{ asset('style/stylingLandingPageAndNavbar.css') }}" type="text/css" rel="stylesheet"/>
    <link href="{{ asset('/style/stylingSchoolClassAndDepartmentAndOrder.css') }}" type="text/css" rel="stylesheet"/>
    <link rel="stylesheet" href="{{ asset('style/stylingBestellungen.css') }}" type="text/css"/>
{% endblock %}

{% block body %}
    <div class="text-4xl">
        <h1>Schulklassen</h1>
    </div>
    <div class="class-filters flex flex-wrap justify-between items-center">
        <div class="flex items-center">
            <form id="classFilterForm" method="get" action="{{ path('app_school_class_index') }}" class="flex items-center">
                <div class="flex items-center mr-5" >
                    <label id="label-year-filter" for="yearFilter" class="class-filter-label">Jahr:  </label>
                    <select id="yearFilter" name="year" class="class-filter">
                        {% for year in allYears %}
                            {% if year == currentYear %}
                                <option value="{{ year }}" selected>{{ year }}</option>
                            {% else %}
                                <option value="{{ year }}">{{ year }}</option>
                            {% endif %}
                        {% endfor %}
                    </select>
                </div>
                <div class="flex items-center mr-5">
                    <label id="label-subject-filter" for="departmentFilter" class="class-filter-label">Abteilungen:  </label>
                    <select id="departmentFilter" name="department" class="class-filter">
                        {% if currentDepartment == 0 %}
                            <option value="0" selected>Alle</option>
                        {% else %}
                            <option value="0">Alle</option>
                        {% endif %}
                        {% for department in departments %}
                            {% if department.id == currentDepartment %}
                                <option value="{{ department.id }}" selected>{{ department.name }}</option>
                            {% else %}
                                <option value="{{ department.id }}">{{ department.name }}</option>
                            {% endif %}
                        {% endfor %}
                    </select>
                </div>
            </form>
        </div>
    </div>


    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>JG</th>
                <th>Schüleranzahl gesamt</th>
                <th>Schüleranzahl ohne R.</th>
                <th>Repetenten</th>
                <th>Benutztes Budget</th>
                <th>Budget der Klasse</th>
                {% if 'ROLE_ADMIN' in user.roles or 'ROLE_AV' in user.roles %}
                    <th></th>
                {% endif %}
            </tr>
        </thead>

        <script>
            document.getElementById('yearFilter').addEventListener('change', function () {
                document.getElementById('yearForm').submit();
            });
        </script>

        <tbody>
        {% for school_class in school_classes %}
            <tr>
                <td>{{ school_class.name }}</td>
                <td>{{ school_class.grade }}</td>
                <td>{{ school_class.studentsAmount + school_class.repAmount }}</td>
                <td>{{ school_class.studentsAmount }}</td>
                <td>{{ school_class.repAmount }}</td>
                <td>{{ school_class.usedBudget | number_format(2, ',','.')}}</td>
                <td>{{ school_class.budget | number_format(2, ',','.')}}</td>
                {% if 'ROLE_ADMIN' in user.roles or 'ROLE_AV' in user.roles %}
                    <td>
                        <div class="actionIcons">
                            <a href="{{ path('app_school_class_edit', {'id': school_class.id}) }}"><img class="img-size" src="{{ asset('images/edit.png') }}" alt="Bearbeiten"></a>
                            <a href="{{ path('app_school_class_duplicate', {'id': school_class.id}) }}"><img class="img-size" src="{{ asset('images/duplicate.png') }}" alt="Duplizieren"></a>
                            {% if 'ROLE_ADMIN' in user.roles %}
                                <a href="{{ path('app_school_class_delete', {'id': school_class.id}) }}"><img class="img-size" src="{{ asset('images/delete.png') }}" alt="Löschen"></a>
                            {% endif %}
                        </div>
                    </td>
                {% endif %}
            </tr>
        {% else %}
            <tr>
                <td colspan="9">Keine Einträge gefunden!</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a class="create-new" href="{{ path('app_school_class_new') }}">Neu Anlegen</a>

    <script>
        document.getElementById('yearFilter').addEventListener('change', function() {
            document.getElementById('classFilterForm').submit();
        });
        document.getElementById('departmentFilter').addEventListener('change', function() {
            document.getElementById('classFilterForm').submit();
        });
    </script>
{% endblock %}