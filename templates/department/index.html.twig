{% extends 'base.html.twig' %}

{% block title %}{{ parent() }} Abteilung Übersicht{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('/style/stylingSchoolClassAndDepartmentAndOrder.css') }}" type="text/css" />
{% endblock %}

{% block body %}
    <style>
        .progress-bar-container {
            width: 100%;
            background-color: #f3f3f3;
            border-radius: 5px;
        }

        .progress-bar {
            height: 20px;
            background-color: #378fbe;
            border-radius: 5px;
        }

        .img-size {
            margin: auto;
            height: 32px;
            width: 32px;
        }
    </style>

    <div class="text-4xl">
        <h1>Abteilungen</h1>
    </div>

    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>
                    <form id="yearForm" method="get" action="{{ path('app_department_index') }}">
                        <select id="yearFilter" name="year" class="year-filter">
                            {% for year in allYears %}
                                {% if year == currentYear %}
                                    <option value="{{ year }}" selected>{{ year }}</option>
                                {% else %}
                                    <option value="{{ year }}">{{ year }}</option>
                                {% endif %}
                            {% endfor %}
                        </select>
                    </form>
                </th>
                <th>AV</th>
                {% if 'ROLE_ADMIN' in user.roles or 'ROLE_AV' in user.roles %}
                    <th>Budget</th>
                    <th>Benutztes Budget</th>
                    <th>Prozentuale Budget Nutzung</th>
                    <th>U.M.E.W</th>
                    <th></th>
                {% endif %}
            </tr>
        </thead>

        <tbody>
        {% for department in departments %}
            <tr {% if department.name == 'Gesamt' %} style="background: #B2FFFF" {% endif %}>
                <td>{{ department.name }}</td>
                <td>{{ department.year }}</td>
                <td>{{ department.headOfDepartment }}</td>
                {% if 'ROLE_ADMIN' in user.roles or 'ROLE_AV' in user.roles %}
                    {% if "all" in showBudgetFor or department.name in showBudgetFor %}
                        <td>{{ department.budget | number_format(2, ',','.') }}</td>
                        <td>{{ department.usedBudget | number_format(2, ',','.')}}</td>
                        <td>
                            {% if department.budget != 0 %}
                                {% set percentage = (department.usedBudget / department.budget * 100) %}
                                {% set percentageShown = (department.usedBudget / department.budget * 100) %}
                            {% else %}
                                {% set percentage = 0 %}
                                {% set percentageShown = 0 %}
                            {% endif %}

                            <div class="progress-bar-container">
                                <div class="progress-bar" style="width: {{ percentage }}%; {% if percentage == 100 %}background-color: red;{% endif %}"></div>
                            </div>
                            {{ percentageShown | number_format(2, ',', '.') }}%
                        </td>
                        <td>{{ department.umew | number_format(2, ',', '.') }}</td>
                        <td>
                            {% if department.name != 'Gesamt' %}
                                <div class="actionIcons">
                                    <a href="{{ path('app_department_edit', {'id': department.id}) }}"><img class="img-size" src="{{ asset('images/edit.png') }}" alt="Bearbeiten"></a>
                                    <a href="{{ path('app_department_duplicate', {'id': department.id}) }}"><img class="img-size" src="{{ asset('images/duplicate.png') }}" alt="Duplizieren"></a>
                                    {% if 'ROLE_ADMIN' in user.roles %}
                                        <a href="{{ path('app_department_delete', {'id': department.id}) }}"><img class="img-size" src="{{ asset('images/delete.png') }}" alt="Löschen"></a>
                                    {% endif %}
                                </div>
                            {% endif %}
                        </td>
                    {% endif %}
                {% endif %}
            </tr>
        {% else %}
            <tr>
                <td colspan="6">Keine Einträge gefunden!</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a class="create-new" href="{{ path('app_department_new') }}">Neu Anlegen</a>

    <script>
        document.getElementById('yearFilter').addEventListener('change', function () {
            document.getElementById('yearForm').submit();
        });
    </script>
{% endblock %}
