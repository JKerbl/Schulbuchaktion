{% extends 'base.html.twig' %}

{% block title %}{{ parent() }} Import{% endblock %}

{% block stylesheets %}
    <link href="{{ asset('style/stylingImportPage.css') }}" rel="stylesheet" type="text/css">
{% endblock %}
{% block body %}
    <div class="import-outside-table">
        <div class="headline-import">
            Bitte wählen Sie ihre Import-Datei
        </div>
        <div class="form-div-outside">
            <form id="upload-form" method="post" action="{{ path('xlsx') }}" enctype="multipart/form-data">
                <label id="label-text" for="input-import-file" class="file-upload"> Datei auswählen</label>
                <input id="input-import-file" type="file" name="file" onchange="updateFileName()">
                <button id="upload-excel-btn" class="submit-btn-form" type="submit">Upload</button>
            </form>
        </div>
        <div id="submit-upload">

        </div>
        <div id="output">
            <div id="output-import">

            </div>
            <div id="output-text">

            </div>
            <table class="table table-striped table-hover table-bordered">
                <thead id="output-head">

                </thead>
                <tbody id="output-body">

                </tbody>
            </table>
        </div>
    </div>

    <script>
        $(document).ready(function () {

            $('.submit-btn-form').prop('disabled', true);

            $('#input-import-file').on('change', function () {
                if ($(this).val() !== '') {
                    $('.submit-btn-form').prop('disabled', false);
                } else {
                    $('.submit-btn-form').prop('disabled', true);
                }
            });

            $('#upload-form').on('submit', function (e) {
                e.preventDefault();
                $.ajax({
                    url: $(this).attr('action'),
                    type: $(this).attr('method'),
                    data: new FormData(this),
                    processData: false,
                    contentType: false,
                    success: function (data) {
                        // Clear the old table
                        $('#output-head').empty();
                        $('#output-body').empty();

                        let divElement = document.getElementById("submit-upload");
                        divElement.classList.add("submit-upload-btn");

                        let uploadElement = document.getElementsByClassName("form-div-outside");
                        if (uploadElement.length > 0) {
                            uploadElement[0].style.display = "none";
                        }

                        $('<a href="{{ path('app_import') }}">')
                            .text('Falsche Daten - Neuer Import!')
                            .addClass('back-to-import-btn')
                            .appendTo('#output-import');

                        $('<h3 style="text-align: center">').text('Folgende Daten werden bei Ihrer Bestätigung importiert:').appendTo('#output-text');

                        $('<button>')
                            .text('Import bestätigen')
                            .click(function () {
                                // Call the map-subjects function when the button is clicked
                                $.ajax({
                                    url: '/map-subjects',
                                    type: 'POST',
                                    success: function (data) {
                                        showSubjects(data);
                                    }
                                });
                            }).appendTo('#submit-upload');
                        // Append the new table
                        let count = 0;
                        //var table = $('<table class="table">').appendTo('#output');
                        let row;
                        data.forEach(function (item) {
                            if (count === 0) {
                                row = $('<tr>').appendTo('#output-head');
                            } else {
                                row = $('<tr>').appendTo('#output-body');
                            }
                            Object.values(item).forEach(function (value, index) {
                                if (count === 0) {
                                    $('<th style="width: 150px;">').text(value).appendTo(row);
                                } else {
                                    $('<td>').text(value).appendTo(row);
                                }
                            });
                            if (count === 0) {
                                count++;
                            }
                        });
                    }
                });
            });
        });

        function updateFileName() {
            let input = document.getElementById('input-import-file');
            let label = document.getElementById('label-text');
            if (input.files && input.files.length > 0) {
                label.textContent = "Datei ausgewählt!"
                label.style.color = '#17a1b7'
                // input.files[0].name;
            } else {
                label.textContent = "Datei auswählen";
            }
        }

        function getSubjects() {
            return $.ajax({
                url: '{{ path('app_subject_get_all') }}',
                type: 'GET',
                async: false,
                success: function(data) {
                    subjects = data;
                }
            }).responseJSON;
        }

        function showSubjects(data) {
            // If the Data is empty (no subjects to map) save the data
            if (data.length === 0) {
                $.ajax({
                    url: '/save',
                    type: 'POST',
                    success: function (response) {
                        // Redirect to the returned URL
                        alert('Daten gespeichert!')
                        window.location.href = response.url;
                    }
                });
                return;
            }

            // Clear the old buttons
            $('#submit-upload').empty();

            // Append the new button
            $('<button>')
                .text('Import bestätigen')
                .click(function () {
                    // Call the save function when the button is clicked
                    $.ajax({
                        url: '/save',
                        type: 'POST',
                        success: function (response) {
                            // Redirect to the returned URL
                            alert('Daten gespeichert!')
                            window.location.href = response.url;
                        }
                    });
                }).appendTo('#submit-upload');


            // Clear the old table
            $('#output-head').empty();
            $('#output-body').empty();

            //var table = $('<table class="table">').appendTo('#output');
            let row = $('<tr>').appendTo('#output-head');

            subjects = getSubjects();

            // Add the Column Gegestand
            $('<th style="width: 150px;">Gegenstand</th>').appendTo(row);
            // Adds the column Fachbereich
            $('<th style="width: 150px;">').text('Fachbereich').appendTo(row);

            data.forEach(function (item) {
                row = $('<tr>').appendTo('#output-body');

                $('<td>').text(item).appendTo(row);

                // Create a new td element and append the select element to it
                let td = $('<td>').appendTo(row);
                let select = $('<select id="selectSubject" style="border: 3px dashed red;">').appendTo(td);
                $('<option disabled selected>').text('Bitte wählen').appendTo(select);
                subjects.forEach(subject => {
                    $('<option>').val(subject.id).text(subject.name).appendTo(select);
                });
                select.addClass('select-style');
                select.addClass('select-style').on('change', function() {
                    $(this).css('border', '1px solid grey');
                });
                select.on('change', function() {
                    MapSubject($(this).val(), item);
                });
            });
        }

        function MapSubject($subjectId, $subjectName) {
            $.ajax({
                url: '{{ path('add-subject-map') }}',
                type: 'POST',
                dataType: 'json',
                data: {
                    subjectId: $subjectId,
                    subjectName: $subjectName
                },
                success: function(response) {
                    if (response.success) {
                        console.log('Gegenstand hinzugefügt');
                    }
                },
                error: function() {
                    console.log('Gegenstand konnte nicht hinzugefügt werden');
                }
            });
        }

    </script>
{% endblock %}
